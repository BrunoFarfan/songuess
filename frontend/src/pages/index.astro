---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/manrope";
import Game from "../components/Game";
import "../styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Songuess — hear a little more, one guess at a time." />
    <meta name="theme-color" content="#171512" />
    <link rel="canonical" href="https://songuess.bruni.to/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Songuess" />
    <meta property="og:title" content="Songuess — Name that song" />
    <meta
      property="og:description"
      content="Hear a little more, one guess at a time. Put your music knowledge on the record."
    />
    <meta property="og:url" content="https://songuess.bruni.to/" />
    <meta property="og:image" content="https://songuess.bruni.to/songuess-social.png" />
    <meta property="og:image:secure_url" content="https://songuess.bruni.to/songuess-social.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Songuess wordmark beside a vinyl record with the invitation to name that song."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Songuess — Name that song" />
    <meta
      name="twitter:description"
      content="Hear a little more, one guess at a time. Put your music knowledge on the record."
    />
    <meta name="twitter:image" content="https://songuess.bruni.to/songuess-social.png" />
    <meta
      name="twitter:image:alt"
      content="Songuess wordmark beside a vinyl record with the invitation to name that song."
    />
    <title>Songuess — Name that song</title>
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <main>
      <Game client:load />
    </main>
  </body>
</html>
