# Relative paths are resolved from backend/ when commands are run there.
SONGUESS_DATABASE_PATH=data/songuess.sqlite3

# Optional for local Uvicorn; required as a Worker secret in preview/production.
# Set a random value of at least 32 characters; keep it stable to preserve guest sessions.
SONGUESS_GUEST_SECRET=

# Optional. Token-free discovery uses public sitewide charts and direct-artist LB Radio.
# When present, authenticated top-recordings-for-artist results are tried first.
LISTENBRAINZ_TOKEN=
