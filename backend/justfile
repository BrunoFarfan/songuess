# Show available backend commands.
default:
  @just --list

# Fix lint issues, format the backend, and verify it is clean.
lint:
  uv run ruff check src tests ../dataset --fix
  uv run ruff format src tests ../dataset
  uv run ruff check src tests ../dataset

# Run all backend and importer tests.
test:
  cd .. && uv run --project backend pytest backend/tests

# Start the FastAPI development server.
dev:
  uv run uvicorn --app-dir src app.main:app --reload

# Build a complete application-only D1 seed and deterministic manifest.
export-d1 output="../output/catalog.sql":
  cd .. && uv run --project backend python -m dataset.export_d1 --output {{output}}

# Build the local catalog from ListenBrainz, MusicBrainz, and Apple.
populate *args:
  cd .. && uv run --project backend python -m dataset.populate {{args}}

# Resumably backfill explicit MusicBrainz countries for existing credited artists.
backfill-countries:
  cd .. && uv run --project backend python -m dataset.populate --backfill-countries

# Resumably backfill structured MusicBrainz artist identities and credits.
backfill-artists:
  cd .. && uv run --project backend python -m dataset.populate --backfill-artists

# Backfill exact Apple Music URLs and MusicBrainz-linked Spotify tracks.
backfill-streaming-links *args:
  cd .. && uv run --project backend python -m dataset.populate --backfill-streaming-links {{args}}

# Prefer explicit Apple tracks, then unrated tracks, and use clean tracks only as fallback.
backfill-explicit-versions *args:
  cd .. && uv run --project backend python -m dataset.populate --backfill-explicit-versions {{args}}

# Development-only benchmark of stream counts exposed in public Spotify track HTML.
spotify-streams-mvp *args:
  cd .. && uv run --project backend python -m dataset.spotify_streams_mvp {{args}}

# Idempotently resolve Spotify links, hydrate stream counts, and rebuild percentiles.
spotify-streams-browser *args:
  cd .. && uv run --project backend python -m dataset.spotify_streams_browser {{args}}

# Audit evidence-aware genre classifications without changing the catalog.
audit-genres *args:
  cd .. && uv run --project backend python -m dataset.populate --audit-genres {{args}}

# Replace catalog genre links using the audited evidence-aware classifier.
backfill-genres *args:
  cd .. && uv run --project backend python -m dataset.populate --backfill-genres {{args}}

# Snapshot enabled catalog identities before a population run.
snapshot-catalog path:
  cd .. && uv run --project backend python -m dataset.verify --snapshot {{path}}

# Verify exact totals, unique identities, previews, preservation, and year distribution.
verify-catalog *args:
  cd .. && uv run --project backend python -m dataset.verify {{args}}

# Record catalog/database/cache sizes and invariants.
cache-baseline *args:
  cd .. && uv run --project backend python -m dataset.cache_maintenance baseline {{args}}

# Compact provider and runtime SQLite databases.
compact-caches *args:
  cd .. && uv run --project backend python -m dataset.cache_maintenance compact {{args}}

# Preview obsolete cache removal; pass --apply to delete the listed paths.
cleanup-caches *args:
  cd .. && uv run --project backend python -m dataset.cache_maintenance cleanup {{args}}

# Produce an inspectable ranked candidate manifest without provider enrichment.
discover *args:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline discover {{args}}

# Append one bounded checkpoint from an approved candidate manifest.
populate-manifest *args:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline populate {{args}}

# Refresh mutable Spotify counts without rediscovering or rebuilding songs.
refresh-catalog *args:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline refresh {{args}}

# Disable only fully checked songs with persistent Spotify identity mismatches.
disable-streaming-failures *args:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline disable-streaming-failures {{args}}

# Verify append-only preservation plus links, previews, identities, and counts.
verify-pipeline *args:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline verify {{args}}

# Export only application-facing rows added since an identity snapshot.
export-delta *args:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline export-delta {{args}}

# Produce the measured checkpoint evaluation report.
evaluate-catalog *args:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline evaluate {{args}}

# Build the inspectable candidate manifest for the measured 5k -> 10k pilot.
discover-10000:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline discover --target-total 10000 --candidate-count 30000 --artist-count 5000 --recordings-per-artist 30 --discovery-workers 12

# Append at most the next 1,000 validated songs from the approved 10k manifest.
populate-next-1000:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline populate --target-total 10000 --checkpoint-size 1000

# Resumably populate to an explicit idempotent checkpoint boundary.
populate-to checkpoint:
  cd .. && uv run --project backend python -m dataset.catalog_pipeline populate --target-total 10000 --checkpoint-target {{checkpoint}}

# Incrementally populate the first requested milestone.
populate-5000:
  cd .. && uv run --project backend python -m dataset.populate --target-total 5000 --candidates 11000 --year-min 1950 --year-max 2026 --artist-count 1000 --recordings-per-artist 60

# Incrementally resume toward the full requested catalog.
populate-25000:
  cd .. && uv run --project backend python -m dataset.populate --target-total 25000 --candidates 45000 --year-min 1950 --year-max 2026 --artist-count 1000 --recordings-per-artist 60
