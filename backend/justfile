# Show available backend commands.
default:
  @just --list

# Fix lint issues, format the backend, and verify it is clean.
lint:
  uv run ruff check src tests ../dataset --fix
  uv run ruff format src tests ../dataset
  uv run ruff check src tests ../dataset

# Run all backend and importer tests.
test:
  cd .. && uv run --project backend pytest backend/tests
  just worker-test

# Verify the native production Worker API independently of Python.
worker-test:
  node --test tests/*.test.mjs

# Start the FastAPI development server.
dev:
  uv run uvicorn --app-dir src app.main:app --reload

# Run the same room retention cleanup used by the hourly Worker schedule.
rooms-cleanup:
  PYTHONPATH=src uv run python -m app.rooms_cleanup

# Run an explicit offline dataset module without accumulating one-off recipes.
dataset module *args:
  cd .. && uv run --project backend python -m dataset.{{module}} {{args}}
